{
  "name": "@veyndo/sdk",
  "version": "0.4.15",
  "description": "JavaScript and TypeScript client for Veyndo Commerce component HTTP and MCP APIs",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "contracts",
    "README.md",
    "LICENSE",
    "PROVENANCE.json",
    "HOST-PROVENANCE.json",
    "docs",
    "examples/browser*",
    "examples/store-catalog.mjs"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./guest": "./src/guest.js",
    "./contracts": "./contracts/operations.json",
    "./host": {
      "types": "./src/host.d.ts",
      "import": "./src/host.js"
    },
    "./host-contract": "./contracts/host-exchange-v1.json",
    "./composition": {
      "types": "./src/composition.d.ts",
      "import": "./src/composition.js"
    },
    "./knowledge": {
      "types": "./src/knowledge.d.ts",
      "import": "./src/knowledge.js"
    },
    "./catalog": {
      "types": "./src/catalog.d.ts",
      "import": "./src/catalog.js"
    },
    "./checkout": {
      "types": "./src/checkout.d.ts",
      "import": "./src/checkout.js"
    },
    "./account": {
      "types": "./src/account.d.ts",
      "import": "./src/account.js"
    },
    "./a2ui": {
      "types": "./src/a2ui.d.ts",
      "import": "./src/a2ui.js"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/transport.js && node --check src/guest.js && node --check src/host.js && python3 scripts/sync-host-contracts.py --check && node --check src/composition.js && node --check src/workspace.js && node --check src/a2ui.js && node --check src/knowledge.js && node --check src/catalog.js && node --check src/checkout.js && node --check src/account.js && node --check examples/browser.mjs && node --check examples/browser-catalog.mjs",
    "test:types": "tsc --noEmit -p test/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/veyndo/sdk.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@a2ui/web_core": "0.15.0",
    "typescript": "^5.9.3"
  }
}
